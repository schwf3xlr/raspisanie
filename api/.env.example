# PostgreSQL connection string.
# Формат: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/raspisanie?schema=public"

# Порт бэкенда.
PORT=3001

# --- Админ-панель ---
# Логин администратора.
ADMIN_LOGIN=admin
# Пароль администратора. Пока plain text.
ADMIN_PASSWORD=change-this-strong-password
# Секрет для подписи cookie сессии.
SESSION_SECRET=random-long-string-please-change-me

# --- Push-уведомления (Firebase Cloud Messaging) ---
# Опционально. Без этих переменных бэкенд просто не будет слать пуши —
# приложение работает как обычно, галочка «Отправить push» в админке будет неактивна.
# Как получить файл — см. PUSH.md.
# Абсолютный путь к JSON-ключу сервисного аккаунта Firebase:
# FCM_SERVICE_ACCOUNT_FILE=/home/deploy/raspisanie/api/fcm-service-account.json
# Альтернатива — весь JSON одной строкой (удобно для CI/Docker без файловой системы):
# FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"…", ...}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- справочники ----------

model Class {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  sortKey   Int      @default(0)
  createdAt DateTime @default(now())
}

model Teacher {
  id        Int      @id @default(autoincrement())
  fullName  String   @unique
  shortName String
  createdAt DateTime @default(now())
}

model Subject {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
}

model Room {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  kind      String   @default("regular")
  createdAt DateTime @default(now())
}

// ---------- шаблон (день недели) ----------

model LessonTemplate {
  id        Int      @id @default(autoincrement())
  day       String
  className String
  number    Int
  timeStart String
  timeEnd   String
  groups    Json
  updatedAt DateTime @updatedAt

  @@unique([day, className, number])
  @@index([className])
}

// ---------- override на конкретную дату ----------

model LessonOverride {
  id          Int      @id @default(autoincrement())
  date        DateTime @db.Date
  className   String
  number      Int
  timeStart   String
  timeEnd     String
  groups      Json
  isCancelled Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  @@unique([date, className, number])
  @@index([date])
  @@index([className])
}

// ---------- звонки (по дням недели, глобально) ----------

model TimeSlot {
  id        Int    @id @default(autoincrement())
  day       String
  number    Int
  timeStart String
  timeEnd   String

  @@unique([day, number])
}

// ---------- дистант на конкретную дату ----------

model DistantMark {
  id           Int      @id @default(autoincrement())
  date         DateTime @db.Date
  className    String
  lessonNumber Int?
  note         String?
  createdAt    DateTime @default(now())

  @@index([date])
  @@index([className])
}

// ---------- публикация конкретного дня ----------

model PublishedDay {
  id          Int      @id @default(autoincrement())
  date        DateTime @unique @db.Date
  publishedAt DateTime @default(now())
}

// ---------- админы и сессии ----------

model AdminUser {
  id           Int      @id @default(autoincrement())
  login        String   @unique
  passwordHash String
  role         String   // 'school' | 'tech'
  displayName  String?
  createdAt    DateTime @default(now())
  sessions     AdminSession[]
}

model AdminSession {
  id        String   @id
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      AdminUser? @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int?

  @@index([userId])
}

// ---------- FCM токены устройств ----------

model DeviceToken {
  id         Int      @id @default(autoincrement())
  token      String   @unique
  platform   String   @default("android")
  className  String?  // подписан на расписание этого класса
  teacherId  Int?     // ИЛИ на расписание учителя
  // Настройки уведомлений устройства: { publish: bool, changes: bool, distant: bool, manual: bool }.
  // null = все включены (значение по умолчанию для старых токенов).
  notifPrefs Json?
  createdAt  DateTime @default(now())
  lastSeen   DateTime @default(now()) @updatedAt

  @@index([className])
  @@index([teacherId])
}
